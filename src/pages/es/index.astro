---
// IMPORTS
import type { Multi } from "src/types.ts";
import BaseLayout from "@layouts/BaseLayout.astro";
import LogoRender from "@components/LogoRender.astro";
import Latest from "@components/Latest.astro";
import Contact from "@components/Contact.astro";
import { site } from "@i18n/sections";
import { defaultLang } from "@i18n/ui";

// ACTIONS
// Get locale from folder structure
const locale: keyof Multi = Astro.currentLocale || defaultLang;

// Other
const stack = ["astro", "js", "typescript", "mdx", "tailwind", "threejs"];
---

<BaseLayout
  siteTitle={site.title[locale]}
  description={site.description[locale]}
  pageTitle="Bienvenido 👋"
  locale={locale}
>
  <section class="homepage">
    <div>
      <p class="intersect text-2xl">
        ¡Hola! Soy <span class="italic">José</span>, una persona <strong>
          <span class="italic">radicalmente multidisciplinaria</span></strong
        > con experiencia en investigación, análisis, y desarrollo de software.
      </p>
    </div>

    <div class="md:flex gap-2 intersect py-5">
      <div
        class="w-full md:bg-gray-800 md:dark:bg-gray-900 md:text-white md:border md:border-teal-300 md:dark:border-white md:border-solid md:dark:border-dotted md:p-5"
      >
        <h3 class="underline md:no-underline">Programación "freelance"</h3>
        <p class="text-sm my-1 text-black">
          <span class="py-1 px-2 bg-teal-300 rounded-md border border-black"
            >#Computación cuántica</span
          >
          <span class="py-1 px-2 bg-teal-300 rounded-md border border-black"
            >#IA</span
          >
          <span class="py-1 px-2 bg-teal-300 rounded-md border border-black"
            >#Fullstack</span
          >
          <span class="py-1 px-2 bg-teal-300 rounded-md border border-black"
            >#3D</span
          >
        </p>
        <p class="inline md:block">
          Vendo soluciones, con código. El objetivo es ayudarte a alcanzar tus
          objetivos.
        </p>
        <p class="inline">
          <a href="/servicios/es">Lista de servicios</a>.
        </p>
      </div>

      <div
        class="mt-5 md:mt-0 w-full md:bg-gray-800 md:dark:bg-gray-900 md:text-white md:border md:border-teal-300 md:dark:border-white md:border-solid md:dark:border-dotted md:p-5"
      >
        <h3 class="underline md:no-underline">Manejo de proyectos</h3>
        <p class="text-sm my-1 text-black">
          <span class="py-1 px-2 bg-teal-300 rounded-md border border-black"
            >#Estrategia</span
          >
          <span class="py-1 px-2 bg-teal-300 rounded-md border border-black"
            >#Diseño</span
          >
          <span class="py-1 px-2 bg-teal-300 rounded-md border border-black"
            >#Implementación</span
          >
        </p>
        <p class="inline md:block">
          Le entiendo a ambos tu técnicos y a tu oficina de estrategia. ¡No se
          diga más!
        </p>
        <p class="inline">
          <a href={"mailto:hello@josebolanos.xyz"} target="_blank">Contáctame</a
          >.
        </p>
      </div>
    </div>

    <br />
    <span>
      <p class="intersect"><strong>Sitio hecho con:</strong></p>
      <span class="flex flex-wrap"
        >{
          stack.map((item: string) => (
            <LogoRender label={item} locale={locale} />
          ))
        }</span
      >
    </span>
  </section>

  <section>
    <Latest
      sectionTitle="Últimas novedades"
      numberOfEntries={6}
      locale={locale}
    />
  </section>

  <section class="intersect">
    <Contact locale={locale} />
  </section>
</BaseLayout>
