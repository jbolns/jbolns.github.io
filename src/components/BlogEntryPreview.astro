---
// IMPORTS
import { Image } from "astro:assets";
import LogoRender from "./LogoRender.astro";

// ACTIONS
// Get post info as props
const { post, locale } = Astro.props;
const labels = post.collection === "blog" ? post.data.tags : post.data.stack;
---

<li
	class="group intersect special mt-5 mx-[5%] odd:mr-[25%] even:ml-[25%] md:mx-0 md:odd:mr-0 md:even:ml-0"
>
	<a href={`/${post.collection}/${post.id}/`}>
		<Image
			src={post.data.heroImage}
			alt="Entry thumbnail"
			width={720}
			height={360}
			class="m-0 p-0 border border-black dark:border-white group-hover:duration-1000 group-hover:shadow-lg group-hover:rounded-t-3xl group-hover:animate-pulse"
		/>
		<span class="hidden tiny:block text-sm!">
			{
				labels
					.slice(0, 3)
					.map((label: string) => (
						<LogoRender label={label} locale={locale} />
					))
			}
		</span>
		<h2
			class="group-hover:underline group-hover:animate-wiggle text-2xl mt-0!"
		>
			{post.data.title}
		</h2>
	</a>
</li>
