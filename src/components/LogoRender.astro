---
// IMPORTS
import { labelStrings } from "@i18n/ui";

// ACTIONS
// Get props, incl. locale
let { label, locale, render_icons = true } = Astro.props;
label = label.toLowerCase().replace("digital ", "");

// Rewrites (needed for CV section)
label === "industry" ? (label = "coding") : (label = label);

// Translation flags for special categories
const flags = ["coding", "policy", "academia"];
---

<span
  class="inline-flex items-center mr-2 mt-2"
>
  <img
    src={`/icons/${label}.svg`}
    alt={`${label}.`}
    class="inline mr-1 p-2 w-8 h-auto bg-gray-300 rounded-full group-hover:duration-1000 group-hover:bg-amber-200 group-hover:animate-pulse"
  />
  {
    flags.includes(label)
      ? labelStrings[label][locale].toUpperCase()
      : label.toUpperCase()
  }</span
>
